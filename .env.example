# Copy to .env and fill in values as needed. No variables are required to run the site.
# Public site origin, with no trailing slash. Canonical URLs, the sitemap, robots.txt
# and event structured data stay relative until this is set. Deploy step: set
# VITE_SITE_URL in the host's environment settings.
VITE_SITE_URL=
# Overrides the ticket checkout URL (defaults to the confirmed Selar link in src/lib/event.ts).
VITE_TICKET_URL=
